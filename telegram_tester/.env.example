# --- Versione bot (sender.py) ---
# Token del bot ottenuto da @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Versione account personale (user_sender.py) ---
# Credenziali da https://my.telegram.org > API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opzionale: sessione gia' pronta (da `python user_sender.py login --print-string`).
# Se non c'e', viene usato il file user.session creato dal login.
# ATTENZIONE: questa stringa da' accesso completo al tuo account Telegram.
# TELEGRAM_SESSION=
